# 门诊医嘱-病程矛盾实时检测系统环境变量配置
# 复制此文件为 .env 并填入实际值

# ==================== 数据源配置 ====================
# HIS 医嘱数据文件路径（支持 CSV 或 JSON）
HIS_DATA_PATH=data/sample/his_orders_sample.csv

# EMR 病程记录数据文件路径（支持 CSV 或 JSON）
EMR_DATA_PATH=data/sample/emr_records_sample.csv

# 矛盾检测结果输出目录
OUTPUT_DIR=data/output

# ==================== 规则配置 ====================
# 自定义规则文件路径（YAML 格式），可选
# RULES_FILE_PATH=.config/contradiction_rules.yaml

# 时间窗口（分钟）：医嘱和病程记录之间的时间窗口
TIME_WINDOW_MINUTES=30

# ==================== 告警配置 ====================
# 是否启用告警（true/false）
ALERT_ENABLED=true

# 单个医生每日矛盾数阈值，超过此值触发告警
DOCTOR_DAILY_THRESHOLD=5

# 科室每日矛盾数阈值
DEPARTMENT_DAILY_THRESHOLD=10

# 高危矛盾数阈值
HIGH_SEVERITY_THRESHOLD=2

# Webhook 告警配置
WEBHOOK_ENABLED=false
WEBHOOK_URL=

# ==================== Web 服务配置 ====================
# Web API 服务器地址（用于 TypeScript CLI 调用）
PYTHON_BACKEND_URL=http://localhost:3000

# Web 服务端口
WEB_PORT=3000

# ==================== 日志配置 ====================
# 日志级别：DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# 独立日志文件目录
LOG_DIR=logs
